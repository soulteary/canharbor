{
  "name": "canharbor-web",
  "version": "0.1.0-dev",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests *.ts index.html",
    "format:check": "prettier --check src tests *.ts index.html"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0",
    "prettier": "^3.6.0"
  }
}
